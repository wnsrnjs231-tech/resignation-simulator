<!DOCTYPE html>

<html lang="ko">

<head>
    <meta charset="UTF-8">

    ```
    <!-- 모바일 화면 대응 -->
    <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0">

    <!-- 브라우저 탭 제목 -->
    <title>퇴사 시뮬레이터</title>

    <!-- 게임 CSS -->
    <link
            rel="stylesheet"
            href="/css/game.css">
    ```

</head>

<body>

<!-- ==================================================
     게임 전체 영역
     ================================================== -->

<div class="game-container">

    ```
    <!-- ==================================================
         게임 제목
         ================================================== -->

    <h1 class="game-title">
        🏢 퇴사 시뮬레이터
    </h1>


    <!-- ==================================================
         날짜 / 직급
         ================================================== -->

    <div class="player-header">

    <span>
        📅 Day {{day}}
    </span>

        <span>
        🏢 직급: {{position}}
    </span>

    </div>


    <!-- ==================================================
         플레이어 상태
         ================================================== -->

    <div class="status-box">

        <p>
            💰 보유 금액:
            {{money}}원
            <strong>{{moneyChange}}</strong>
        </p>

        <p>
            💳 카드빚:
            {{cardDebt}}원
            <strong>{{cardDebtChange}}</strong>
        </p>

        <p>
            💵 월급:
            {{salary}}원
            <strong>{{salaryChange}}</strong>
        </p>

        <p>
            😵 스트레스:
            {{stress}}
            <strong>{{stressChange}}</strong>
        </p>

        <p>
            💼 업무 능력:
            {{ability}}
            <strong>{{abilityChange}}</strong>
        </p>

        <p>
            ❤️ 체력:
            {{stamina}}
            <strong>{{staminaChange}}</strong>
        </p>

        <p>
            ⭐ 평판:
            {{reputation}}
            <strong>{{reputationChange}}</strong>
        </p>

    </div>


    <!-- ==================================================
         인간관계
         ================================================== -->

    <div class="relationship-box">

        <h3>
            🤝 인간관계
        </h3>

        <p>
            팀장: {{teamLeaderRelationship}}
        </p>

        <p>
            선배: {{seniorRelationship}}
        </p>

        <p>
            동료: {{coworkerRelationship}}
        </p>


        <!-- --------------------------------------------------
             NPC 특수 효과
             -------------------------------------------------- -->

        {{#teamLeaderSupportUnlocked}}

            <p>
                ⭐ 팀장 지원 효과 해금
            </p>

        {{/teamLeaderSupportUnlocked}}


        {{#seniorHelpUnlocked}}

            <p>
                ⭐ 선배 도움 효과 해금
            </p>

        {{/seniorHelpUnlocked}}


        {{#coworkerHelpUnlocked}}

            <p>
                ⭐ 동료 도움 효과 해금
            </p>

        {{/coworkerHelpUnlocked}}

    </div>


    <!-- ==================================================
         게임 진행 중
         ================================================== -->

    {{#gamePlaying}}


        <!-- ==================================================
             오늘의 이벤트
             ================================================== -->

        <div class="event-box">

            <h2>
                {{event}}
            </h2>

        </div>


        <!-- ==================================================
             일반 이벤트
             ================================================== -->

        {{#normalEvent}}

            <form
                    class="choice-form"
                    action="/game/choice"
                    method="post">

                <button
                        type="submit"
                        name="choice"
                        value="1">
                    1. {{choice1}}
                </button>

                <button
                        type="submit"
                        name="choice"
                        value="2">
                    2. {{choice2}}
                </button>

            </form>

        {{/normalEvent}}


        <!-- ==================================================
             후속 이벤트
             ================================================== -->

        {{#followupEvent}}

            <form
                    action="/game/followup"
                    method="post">

                <button type="submit">
                    확인
                </button>

            </form>

        {{/followupEvent}}


        <!-- ==================================================
             월급 이벤트
             ================================================== -->

        {{#salaryEvent}}

            <form
                    action="/game/salary"
                    method="post">

                <button type="submit">
                    💰 월급 받기
                </button>

            </form>

        {{/salaryEvent}}


        <!-- ==================================================
             업무 태만 메시지
             ================================================== -->

        {{#neglectCountMessage}}

            <div class="message-box">
                {{neglectCountMessage}}
            </div>

        {{/neglectCountMessage}}


        {{#neglectMessage}}

            <div class="message-box">
                {{neglectMessage}}
            </div>

        {{/neglectMessage}}


        <!-- ==================================================
             업무 태만 징계
             ================================================== -->

        {{#neglectDisciplinePending}}

            <div class="warning-box">

                <h3>
                    🚨 업무 태만 징계
                </h3>

                <p>
                    반복된 업무 태만으로 징계 대상이 되었습니다.
                </p>


                <!-- --------------------------------------------------
                     감봉 수락
                     -------------------------------------------------- -->

                <form
                        action="/game/neglect/paycut"
                        method="post">

                    <button type="submit">
                        💸 감봉을 받아들이고 계속 근무한다
                    </button>

                </form>


                <!-- --------------------------------------------------
                     퇴사
                     -------------------------------------------------- -->

                <form
                        action="/game/neglect/resign"
                        method="post">

                    <button type="submit">
                        🏃 퇴사한다
                    </button>

                </form>

            </div>

        {{/neglectDisciplinePending}}


        <!-- ==================================================
             과장 승진 선택
             ================================================== -->

        {{#promotionChoicePending}}

            <div class="promotion-box">

                <h2>
                    🎉 과장 승진 대상입니다!
                </h2>

                <p>
                    현재 직급: 대리
                </p>

                <p>
                    다음 직급: 과장
                </p>


                <!-- --------------------------------------------------
                     승진 수락
                     -------------------------------------------------- -->

                <form
                        action="/game/promotion/accept"
                        method="post">

                    <button type="submit">
                        📈 승진한다
                    </button>

                </form>


                <!-- --------------------------------------------------
                     승진 포기
                     -------------------------------------------------- -->

                <form
                        action="/game/promotion/decline"
                        method="post">

                    <button type="submit">
                        🌿 승진을 포기한다
                    </button>

                </form>

            </div>

        {{/promotionChoicePending}}


        <!-- ==================================================
             자발적 퇴사
             ================================================== -->

        <div class="resign-box">

            <form
                    action="/game/resign/confirm"
                    method="post">

                <button type="submit">
                    🚪 퇴사한다
                </button>

            </form>

        </div>


        <!-- ==================================================
             퇴사 확인
             ================================================== -->

        {{#resignConfirm}}

            <div class="warning-box">

                <h3>
                    정말 퇴사하시겠습니까?
                </h3>


                <!-- --------------------------------------------------
                     퇴사 확정
                     -------------------------------------------------- -->

                <form
                        action="/game/resign/confirm"
                        method="post">

                    <button type="submit">
                        네, 퇴사합니다
                    </button>

                </form>


                <!-- --------------------------------------------------
                     퇴사 취소
                     -------------------------------------------------- -->

                <form
                        action="/game"
                        method="get">

                    <button type="submit">
                        아니요, 계속 다닙니다
                    </button>

                </form>

            </div>

        {{/resignConfirm}}


    {{/gamePlaying}}


    <!-- ==================================================
         게임 종료 화면
         ================================================== -->

    {{#gameOver}}

        <div class="ending-box">


            <!-- --------------------------------------------------
                 좋은 엔딩
                 -------------------------------------------------- -->

            {{#goodEnding}}

                <h2>
                    🎉 GOOD ENDING
                </h2>

            {{/goodEnding}}


            <!-- --------------------------------------------------
                 나쁜 엔딩
                 -------------------------------------------------- -->

            {{#badEnding}}

                <h2>
                    💀 GAME OVER
                </h2>

            {{/badEnding}}


            <!-- --------------------------------------------------
                 엔딩 메시지
                 -------------------------------------------------- -->

            <p>
                {{endingMessage}}
            </p>


            <!-- --------------------------------------------------
                 다시 시작
                 -------------------------------------------------- -->

            <form
                    action="/game/restart"
                    method="post">

                <button type="submit">
                    🔄 다시 시작
                </button>

            </form>

        </div>

    {{/gameOver}}


    <!-- ==================================================
         선택 결과
         ================================================== -->

    {{#result}}

        <div class="result-box">

            <h3>
                선택 결과
            </h3>

            <p>
                {{result}}
            </p>

        </div>

    {{/result}}


    <!-- ==================================================
         자동 승진 메시지
         ================================================== -->

    {{#promotionMessage}}

        <div class="message-box">
            {{promotionMessage}}
        </div>

    {{/promotionMessage}}


    <!-- ==================================================
         월세 납부 메시지
         ================================================== -->

    {{#rentMessage}}

        <div class="message-box">
            {{rentMessage}}
        </div>

    {{/rentMessage}}


    <!-- ==================================================
         인사평가 결과
         ================================================== -->

    {{#performanceResult}}

        <div class="result-box">

            <h3>
                📋 인사평가
            </h3>

            <p>
                {{performanceResult}}
            </p>

        </div>

    {{/performanceResult}}
    ```

</div>

</body>

</html>
